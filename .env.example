# Copy this file to ".env" and fill in your values.
# .env is in .gitignore so secrets stay local.

# --- Optional: TikTok session cookies ----------------------------------
# Set BOTH to unlock streams that require login/region. Leave blank to
# use anonymous mode (works for public game/IRL rooms like tv_asahi_news).
#
# Where to find them:
#   1. Log in to https://www.tiktok.com in Chrome/Edge
#   2. F12 → Application → Cookies → https://www.tiktok.com
#   3. Copy values of "sessionid" and "tt-target-idc"

TIKTOK_SESSIONID=
TIKTOK_TT_TARGET_IDC=

# --- Optional: Euler Stream signing key --------------------------------
# Free sign-up: https://www.eulerstream.com
# Prevents rate-limiting when connecting to chat WebSocket.
EULER_API_KEY=

# --- Optional: server port (default 3000) ------------------------------
# PORT=3000

# --- Optional: bind host (default 127.0.0.1) ---------------------------
# Set to 0.0.0.0 to allow LAN access from other devices.
# HOST=127.0.0.1

# --- Optional: watcher poll interval (default 30) ----------------------
# WATCH_POLL_SECONDS=30

# --- Optional: explicit ffmpeg path ------------------------------------
# Set only if auto-detection fails.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# --- Optional: disable auto-highlight detection after recording --------
# DISABLE_AUTO_HIGHLIGHTS=1

# --- Optional: shared token for remote access --------------------------
# When set, all /api/* and /files/* requests must present this token
# via X-App-Token header or ?token= query param.
# APP_TOKEN=

# --- Optional: allowed hosts for LAN/tunnel access --------------------
# Comma-separated list of host:port that bypass DNS rebinding protection.
# ALLOWED_HOSTS=myhost.local:3000,192.168.1.10:3000

# --- Optional: trust proxy (for reverse proxy / tunnel) ----------------
# TRUST_PROXY=1
