{
  "name": "tiktok-live-recorder",
  "version": "1.5.0",
  "private": true,
  "type": "commonjs",
  "description": "Check TikTok live status, fetch stream URLs, and record live streams.",
  "scripts": {
    "check": "node check.js",
    "stream": "node get-stream.js",
    "record": "node record.js",
    "web": "node server.js",
    "start": "node server.js",
    "app": "node launcher.js",
    "build": "npm --prefix client run build",
    "build:start": "npm --prefix client run build && node server.js",
    "client:dev": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "package:portable": "node scripts/package-release.js",
    "package:all": "node scripts/package-release.js --target all",
    "package:checksums": "node scripts/package-release.js --generate-checksums release-dist/artifacts",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "https-proxy-agent": "^5.0.1",
    "socks-proxy-agent": "^10.1.0",
    "tiktok-live-connector": "^2.5.0"
  }
}
